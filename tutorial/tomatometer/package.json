{
  "name": "tomatometer-tutorial",
  "type": "module",
  "version": "1.0.0",
  "description": "TomatoMeter starter for the ICSOC 2026 tutorial: connect it to SPACE",
  "scripts": {
    "dev": "concurrently -k -n api,web,css -c blue,magenta,gray \"pnpm:dev:server\" \"pnpm:dev:web\" \"pnpm:dev:css\"",
    "dev:server": "nodemon --watch api --watch .env --ext ts,json,env --exec tsx api/backend.ts",
    "dev:web": "vite",
    "dev:css": "tailwindcss -i ./src/static/css/app.css -o ./src/static/css/tailwind.css --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCORELabUS/TomatoMeter.git"
  },
  "author": "Alejandro García Fernández",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SCORELabUS/TomatoMeter/issues"
  },
  "homepage": "https://github.com/SCORELabUS/TomatoMeter#readme",
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "axios": "^0.25.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "space-node-client": "^0.3.0",
    "space-react-client": "^0.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  },
  "private": true
}
